#!/bin/bash
set -euo pipefail

(($# == 0)) || { echo "usage: devtools install" >&2; exit 2; }

[[ $(id -u) -ne 0 ]] || { echo "run this as your own user, not root" >&2; exit 1; }

bundle=${BUNDLE_DIR:-$(cd "$(dirname "$0")" && pwd -P)}
id=$(<"$bundle/VERSION")
base=$(dirname "$bundle")
current=$base/current
dotfiles=$HOME/dotfiles
data=${XDG_DATA_HOME:-$HOME/.local/share}
config=${XDG_CONFIG_HOME:-$HOME/.config}
build_home=/__devtools_home__
export PATH=$HOME/.local/bin:$PATH

notes=()
step() { printf '\n==> %s\n' "$*"; }
note() { notes+=("$*"); }

link() {
  local target=$1 dest=$2
  if [[ -L $dest ]]; then
    [[ $(readlink "$dest") != "$target" ]] || return 0
    rm "$dest"
  elif [[ -e $dest ]]; then
    local backup=$dest.pre-bundle
    [[ ! -e $backup ]] || backup=$dest.pre-bundle-$(date +%Y%m%d%H%M%S)
    mv "$dest" "$backup"
    note "moved $dest to $backup"
  fi
  mkdir -p "$(dirname "$dest")"
  ln -s "$target" "$dest"
}

step "Preparing bundle $id"
if [[ ! -f $bundle/.relocated ]]; then
  home_sed=$(printf '%s' "$HOME" | sed 's/[&|\\]/\\&/g')
  (cd "$bundle" && tr '\n' '\0' <relocate.list | xargs -0 -r sed -i "s|$build_home|$home_sed|g")
  while IFS= read -r path; do
    target=$(readlink "$bundle/$path")
    ln -sfn "$HOME${target#"$build_home"}" "$bundle/$path"
  done <"$bundle/relocate-links.list"
  sh "$bundle/opt/zsh/share/zsh/5.8/scripts/relocate" >/dev/null
  printf '%s\n' "$HOME" >"$bundle/.relocated"
elif [[ $(<"$bundle/.relocated") != "$HOME" ]]; then
  echo "$bundle was set up for HOME=$(<"$bundle/.relocated"); delete it and run devtools install again" >&2
  exit 1
fi
ln -sfn "$id" "$base/.current.tmp"
mv -Tf "$base/.current.tmp" "$current"

step "Setting up ~/dotfiles"
if [[ ! -e $dotfiles ]]; then
  cp -a "$bundle/dotfiles" "$dotfiles"
  echo "  copied the dotfiles repository to $dotfiles"
elif [[ -f $dotfiles/install.conf.yaml ]]; then
  echo "  keeping your existing $dotfiles"
  if [[ $(<"$dotfiles/nvim/lazy-lock.json") != "$(<"$bundle/dotfiles/nvim/lazy-lock.json")" ]]; then
    note "$dotfiles/nvim/lazy-lock.json differs from the bundle's, so nvim may download plugins"
  fi
else
  echo "$dotfiles exists but does not hold these dotfiles; move it aside and run devtools install again" >&2
  exit 1
fi

step "Linking the dotfiles"
"$current/opt/dotbot/dotbot" --quiet --only link -d "$dotfiles" -c "$dotfiles/install.conf.yaml"

step "Linking the tools into ~/.local/bin"
for exe in "$bundle"/bin/*; do
  link "$current/bin/${exe##*/}" "$HOME/.local/bin/${exe##*/}"
done
for exe in "$HOME"/.local/bin/*; do
  if [[ -L $exe && ! -e $exe && $(readlink "$exe") == "$current/"* ]]; then
    rm "$exe"
  fi
done

step "Linking nvim plugins, language servers and zsh plugins"
for path in .local/share/nvim/lazy .local/share/nvim/mason .local/share/nvim/site \
  .local/share/sheldon .cache/tealdeer \
  .local/share/wezterm/plugins/httpssCssZssZsgithubsDscomsZsmrjones2014sZssmart-splitssDsnvim; do
  link "$current/home/$path" "$HOME/$path"
done

step "Installing Claude Code"
claude_version=$(basename "$bundle"/opt/claude/*)
if [[ ! -e $data/claude/versions/$claude_version ]]; then
  install -Dm755 "$bundle/opt/claude/$claude_version" "$data/claude/versions/$claude_version"
fi
[[ -e $HOME/.local/bin/claude ]] || ln -sfn "$data/claude/versions/$claude_version" "$HOME/.local/bin/claude"

step "Installing fonts and terminfo"
mkdir -p "$data/fonts" "$HOME/.terminfo"
cp -n "$bundle"/fonts/*.otf "$data/fonts/"
command -v fc-cache >/dev/null && fc-cache -f "$data/fonts" >/dev/null 2>&1 || true
chmod -R u+w "$HOME/.terminfo"
cp -R "$bundle/terminfo/." "$HOME/.terminfo/"

step "Registering wezterm with the desktop"
wez=$bundle/opt/wezterm/usr/share
install -Dm644 "$wez/icons/hicolor/128x128/apps/org.wezfurlong.wezterm.png" \
  "$data/icons/hicolor/128x128/apps/org.wezfurlong.wezterm.png"
mkdir -p "$data/applications"
sed "s|^TryExec=wezterm|TryExec=$HOME/.local/bin/wezterm|; s|^Exec=wezterm|Exec=$HOME/.local/bin/wezterm|" \
  "$wez/applications/org.wezfurlong.wezterm.desktop" >"$data/applications/org.wezfurlong.wezterm.desktop"
mkdir -p "$config/environment.d"
printf '%s\n' 'PATH=${HOME}/.local/bin:${PATH}' >"$config/environment.d/60-devtools.conf"

step "Generating the colour palette"
if [[ ! -f $data/foxglove/colorscheme.lua ]]; then
  nvim --headless "+Foxglove palette=tokyonight" +qa
fi
bat cache --build >/dev/null

step "Applying desktop settings"
if [[ ${XDG_CURRENT_DESKTOP-} == *GNOME* ]] && command -v gsettings >/dev/null; then
  "$dotfiles/gnome/apply-settings"
elif command -v busctl >/dev/null && busctl --user list 2>/dev/null | grep -q org.kde.kglobalaccel; then
  "$dotfiles/kde/apply-settings"
else
  echo "  skipped: no GNOME or KDE session"
  note "desktop settings need a GNOME or KDE session; run devtools install again from one"
fi

step "Checking keyd"
keyd_conf=$dotfiles/keyd/default.conf
if [[ -r /etc/keyd/default.conf && $(<"$keyd_conf") == "$(</etc/keyd/default.conf)" ]] &&
  systemctl is-active --quiet keyd 2>/dev/null; then
  echo "  keyd is running with this config"
else
  echo "  skipped: keyd needs root"
  note "keyd is not set up; with admin rights, run: sudo $current/opt/keyd/install $keyd_conf"
fi

step "Done: bundle $id is installed"
for line in "${notes[@]}"; do
  echo "  - $line"
done
echo "  - log out and back in so the desktop picks up ~/.local/bin"
others=$(find "$base" -mindepth 1 -maxdepth 1 -type d ! -name "$id" ! -name '*.partial-*' -printf '%f ')
if [[ -n $others ]]; then
  echo "  - older bundles are still unpacked in $base: $others"
fi
