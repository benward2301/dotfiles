{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "7",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "8"
  },
  "paragraph": {
    "color": "7"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "6",
    "bold": true
  },
  "h1": {
    "prefix": "# "
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### ",
    "bold": false
  },
  "h6": {
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "8",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "color": "12",
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "5",
    "underline": true,
    "bold": true,
    "italic": true
  },
  "link_text": {
    "color": "12"
  },
  "image": {
    "color": "5",
    "underline": true,
    "bold": true,
    "italic": true
  },
  "image_text": {
    "color": "8",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "9",
    "background_color": "0"
  },
  "code_block": {
    "margin": 2
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "html_block": {
    "color": "8"
  },
  "html_span": {
    "color": "8"
  }
}
