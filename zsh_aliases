alias g='cd $(git rev-parse --show-toplevel)'
alias gw='cd $(git worktree list | head -1 | cut -d" " -f1)'
alias gs='git status'
alias gr='git reset'
alias grr='git reset --hard origin/$(git branch --show-current)'
alias grh='git reset --hard'
alias gro='git restore'
alias grb='git rebase'
alias grv='git revert'
alias gp='git pull'
alias gph='git push'
alias gphu='git push -u origin $(git branch --show-current)'
alias gc='git commit'
alias gch='git checkout'
alias gsw='git switch'
alias gf='git fetch'
alias ga='git add'
alias gl='git log'
alias gcl='git clean -e .local -e "*.local" -e "*.local.*"'
alias gco='git clone'
alias gst='git stash'
alias gsh='git show --pretty=medium'
alias gd='git diff'
alias gcp='git cherry-pick'
alias gb='git branch'
alias gm='git merge'
alias gmff='git merge --ff-only'
alias gt='git tag'
alias gwrm='git worktree remove'
alias gcw='git add . && git commit -m "wip"'
alias gcwp='gcw && git push'
alias gcm='git commit --amend'

if command -v eza >/dev/null; then
  alias ls='eza --no-quotes --icons=auto -1'
fi
if command -v bat >/dev/null; then
  alias cat='bat --style=header-filename,rule --paging=never'
  alias less='bat --paging=always'
fi

alias v='nvim'
alias oil='nvim -c Oil'

if command -v xdg-open >/dev/null; then
  alias open='xdg-open 2>/dev/null'
  alias o='open'
elif command -v open >/dev/null; then
  alias o='open'
fi

alias y='ucopy'
alias p='upaste'

alias cl='TERM_PROGRAM= atch new -r ctrl_l -z "$(randname)" -- claude --permission-mode auto'

function vt() {
  (
    mkdir -p /tmp/nvim
    file=/tmp/nvim/$(randname)
    if [ -n "$1" ]; then
      file="$file.$1"
    fi
    while IFS= read -r line; do
      echo "$line" >> "$file"
    done
    nvim "$file"
  )
}
