#!/usr/bin/env python3

import fcntl
import os
import pty
import secrets
import select
import signal
import sys
import termios
import tty

DEFAULT_ARGS = ["--role", "general", "--save-session", "-s", secrets.token_hex(4)]

def set_pty_size(master_fd):
    buf = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b"\x00" * 8)
    fcntl.ioctl(master_fd, termios.TIOCSWINSZ, buf)

def main():
    if not sys.stdin.isatty():
        os.execvp("aichat", ["aichat"] + DEFAULT_ARGS + sys.argv[1:])

    pid, master_fd = pty.fork()

    if pid == 0:
        os.execvp("aichat", ["aichat"] + DEFAULT_ARGS + sys.argv[1:])

    set_pty_size(master_fd)

    shutting_down = [False]

    def handle_shutdown(signum, frame):
        os.write(master_fd, b"\x04")
        shutting_down[0] = True

    def handle_sigwinch(signum, frame):
        set_pty_size(master_fd)

    signal.signal(signal.SIGHUP, handle_shutdown)
    signal.signal(signal.SIGTERM, handle_shutdown)
    signal.signal(signal.SIGWINCH, handle_sigwinch)

    old_settings = tty.tcgetattr(sys.stdin)
    try:
        tty.setraw(sys.stdin.fileno())
        while True:
            try:
                fds = [master_fd] if shutting_down[0] else [sys.stdin, master_fd]
                r, _, _ = select.select(fds, [], [], 0.5 if shutting_down[0] else None)
            except InterruptedError:
                continue
            if not r and shutting_down[0]:
                _, status = os.waitpid(pid, os.WNOHANG)
                if status:
                    break
                continue
            if sys.stdin in r:
                data = os.read(sys.stdin.fileno(), 1024)
                if not data:
                    break
                os.write(master_fd, data)
            if master_fd in r:
                data = os.read(master_fd, 1024)
                if not data:
                    break
                os.write(sys.stdout.fileno(), data)
    except OSError:
        pass
    finally:
        tty.tcsetattr(sys.stdin, tty.TCSADRAIN, old_settings)

    _, status = os.waitpid(pid, 0)
    sys.exit(os.waitstatus_to_exitcode(status))

if __name__ == "__main__":
    main()
